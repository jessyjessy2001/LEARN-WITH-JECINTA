# GEMINI_API_KEY: Required for server-side Gemini AI lesson summaries.
# Configure this in AI Studio Settings > Secrets or your deployment environment.
GEMINI_API_KEY=

# APP_URL: Public base URL of the application.
APP_URL=

# ADMIN_PASSCODE: Optional initial/override passcode for the Super Admin (Jecinta Maina) account.
# If left unset, an inline first-run admin claim form lets you set the admin password securely.
ADMIN_PASSCODE=

# SESSION_SECRET: Optional HMAC secret for session verification (auto-generated in memory if omitted).
SESSION_SECRET=

# Zoom Server-to-Server OAuth Credentials (Optional — required for automated Zoom meetings & cloud recordings)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Transactional Email (SMTP via Nodemailer — Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Supabase PostgreSQL deployment credentials (for Supabase/Vercel production migration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
